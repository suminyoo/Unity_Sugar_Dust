  m_Name: TutorialTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 5de412da8ad316e43b5160044d4457ab, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 15551383973888
    m_Localized: Basic Movement
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442880
    m_Localized: Use [W, A, S, D] to move, [Space] to jump, and [Shift] to sprint.
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442881
    m_Localized: Interaction
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442882
    m_Localized: Press [E] to interact, and [F] for quest interactions.
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442883
    m_Localized: UI Controls
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442884
    m_Localized: "Press [Tab] to open the inventory, and [Q] for the quest log. \nUse
      [ESC] to close windows."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442885
    m_Localized: Combat & Gathering
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442886
    m_Localized: "Open your inventory and equip a weapon. \nLeft-click to attack,
      Right-click to mine."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442887
    m_Localized: Area Transition
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442888
    m_Localized: "Fill the Exploration Progress by defeating monsters and mining
      to proceed to the next area. \nYou will fail to move if the progress is too
      low."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442889
    m_Localized: Return & Time Limit
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442890
    m_Localized: 'Finish exploring before sunset.

      Spaceship Stations for a
      safe return appear every 5 areas.

      If you return to town on foot without
      finding a station, you may lose some items in your inventory.'
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442893
    m_Localized: Opening Shop
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442894
    m_Localized: "Place items on the display stand and set their prices. \nInteract
      with the sign to open the shop."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442895
    m_Localized: Checkout
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442896
    m_Localized: "Attend to customers at the counter. \nLeft-click to take money
      and Right-click to put it back. \nGive the correct change and complete the
      sale."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442897
    m_Localized: Counterfeits & Reputation
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442898
    m_Localized: "Reject customers paying with counterfeit money. \nGiving the wrong
      change or rejecting normal customers lowers your reputation and hurts sales."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442899
    m_Localized: Lost Items & Closing Shop
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442900
    m_Localized: "Rejected customers drop items on the floor. Pick them up before
      closing. \nInteract with the sign again to close the shop and view your total
      sales receipt."
    m_Metadata:
      m_Items: []
  - m_Id: 45446340259840
    m_Localized: Save & Rest
    m_Metadata:
      m_Items: []
  - m_Id: 45454695313408
    m_Localized: "Interact with the Diary to save your game, \nand use the Bed to
      sleep and move to the next day."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
