      m_Items: []
  - m_Id: 2337027895336
    m_Localized: Rainbow Sugar Dust
    m_Metadata:
      m_Items: []
  - m_Id: 2337027895337
    m_Localized: Rainbow Sugar Dust. Boasts an overwhelming, perfect flavor that
