  - m_Id: 15551383973888
    m_Localized: "\uAE30\uBCF8 \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442880
    m_Localized: "<color=#fff64d>[W, A, S, D]</color>\uB85C \uC774\uB3D9, <color=#fff64d>[Space]</color>\uB85C
      \uC810\uD504, <color=#fff64d>[Shift]</color>\uB85C \uB2EC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r
      \n<color=#fff64d>[\uD720 \uD074\uB9AD]</color>\uC73C\uB85C \uC2DC\uC810\uC744
      \uBCC0\uACBD\uD569\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442881
    m_Localized: "\uC0C1\uD638\uC791\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442882
    m_Localized: "<color=#fff64d>[E]</color>\uB85C \uC0C1\uD638\uC791\uC6A9, <color=#fff64d>[F]</color>\uB85C
      \uD018\uC2A4\uD2B8 \uC0C1\uD638\uC791\uC6A9\uC744 \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442883
    m_Localized: "UI \uC870\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442884
    m_Localized: "<color=#fff64d>[Tab]</color>\uC73C\uB85C \uAC00\uBC29\uC744, <color=#fff64d>[Q]</color>\uB85C
      \uD018\uC2A4\uD2B8 \uCC3D\uC744 \uC5FD\uB2C8\uB2E4. \n<color=#fff64d>[ESC]</color>\uB85C
      \uCC3D\uC744 \uB2EB\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442885
    m_Localized: "\uC804\uD22C\uC640 \uCC44\uC9D1"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442886
    m_Localized: "<color=#fff64d>\uAC00\uBC29</color>\uC744 \uC5F4\uACE0 <color=#fff64d>\uBB34\uAE30</color>\uB97C
      \uC7A5\uCC29\uD558\uC138\uC694. \n<color=#fff64d>\uC88C\uD074\uB9AD</color>\uC740
      \uACF5\uACA9, <color=#fff64d>\uC6B0\uD074\uB9AD</color>\uC740 \uCC44\uAD11\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442887
    m_Localized: "\uB9F5 \uC774\uB3D9 \uC870\uAC74"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442888
    m_Localized: "\uBAAC\uC2A4\uD130 \uCC98\uCE58\uC640 \uCC44\uAD11\uC73C\uB85C
      \uB9F5\uC758 <color=#fff64d>\uD0D0\uC0AC\uB3C4</color>\uB97C \uCC44\uC6CC\uC57C
      \uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uB118\uC5B4\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \n<color=#fff64d>\uD0D0\uC0AC\uB3C4</color>\uAC00 \uBD80\uC871\uD558\uBA74
      <color=#ff4d4d>\uC774\uB3D9\uC5D0 \uC2E4\uD328</color>\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442889
    m_Localized: "\uADC0\uD658\uACFC \uC2DC\uAC04\uC81C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442890
    m_Localized: "<color=#ff4d4d>\uC77C\uBAB0 \uC804</color>\uAE4C\uC9C0 \uD0D0\uC0AC\uB97C
      \uB9C8\uCE58\uC138\uC694.\n\uC548\uC804\uD558\uAC8C \uADC0\uD658\uD560 \uC218
      \uC788\uB294 <color=#fff64d>\uC6B0\uC8FC\uC120 \uC815\uAC70\uC7A5</color>\uC740
      <color=#fff64d>5\uAC1C\uC758 \uAD6C\uC5ED</color>\uB9C8\uB2E4 \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\n\uC815\uAC70\uC7A5\uC744
      \uCC3E\uC9C0 \uBABB\uD574 \uADF8\uB0E5 \uAC78\uC5B4\uC11C \uB9C8\uC744\uB85C
      \uB3CC\uC544\uAC08 \uACBD\uC6B0, \n\uAC00\uBC29 \uC548 <color=#ff4d4d>\uC544\uC774\uD15C
      \uC911 \uC77C\uBD80\uB97C \uC783\uC5B4\uBC84\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442893
    m_Localized: "\uC7A5\uC0AC \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442894
    m_Localized: "\uC9C4\uC5F4\uB300\uC5D0 \uBB3C\uAC74\uC744 \uC62C\uB9AC\uACE0
      \uAC00\uACA9\uC744 \uC124\uC815\uD558\uC138\uC694. \n<color=#fff64d>\uD33B\uB9D0</color>\uACFC
      \uC0C1\uD638\uC791\uC6A9\uD558\uBA74 \uC7A5\uC0AC\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442895
    m_Localized: "\uC190\uB2D8 \uACC4\uC0B0"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442896
    m_Localized: "\uACC4\uC0B0\uB300\uC758 \uC190\uB2D8\uC744 \uC751\uB300\uD558\uC138\uC694.
      \n<color=#fff64d>\uC88C\uD074\uB9AD</color>\uC73C\uB85C \uB3C8\uC744 \uAEBC\uB0B4\uACE0
      <color=#fff64d>\uC6B0\uD074\uB9AD</color>\uC73C\uB85C \uB2E4\uC2DC \uB123\uC744
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\uC54C\uB9DE\uC740 <color=#fff64d>\uAC70\uC2A4\uB984\uB3C8</color>\uC744
      \uB3CC\uB824\uC8FC\uACE0 \uD310\uB9E4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442897
    m_Localized: "\uC704\uC870\uC9C0\uD3D0\uC640 \uD3C9\uD310"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442898
    m_Localized: "<color=#ff4d4d>\uC704\uC870\uC9C0\uD3D0</color>\uAC00 \uC874\uC7AC\uD558\uB098
      \uB2E8\uC21C\uD788 \uB354\uB7FD\uAC70\uB098 \uC77C\uBD80 \uC190\uC0C1\uB41C
      \uC9C0\uD3D0\uB294 \uC704\uC870\uC9C0\uD3D0\uAC00 \uC544\uB2D9\uB2C8\uB2E4.\n<color=#ff4d4d>\uC704\uC870\uC9C0\uD3D0</color>\uB97C
      \uB0B4\uB294 \uC190\uB2D8\uC740 \uAC70\uC808\uD558\uC138\uC694.\n\uAC70\uC2A4\uB984\uB3C8\uC774
      \uD2C0\uB9AC\uAC70\uB098 \uC815\uC0C1 \uC190\uB2D8\uC744 \uAC70\uC808\uD558\uBA74
      <color=#ff4d4d>\uD3C9\uD310\uC774 \uAE4E\uC5EC \uB9E4\uCD9C\uC5D0 \uC601\uD5A5</color>\uC744
      \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442899
    m_Localized: "\uBD84\uC2E4\uBB3C\uACFC \uB9C8\uAC10"
    m_Metadata:
      m_Items: []
  - m_Id: 15551480442900
    m_Localized: "\uAC70\uC808\uB2F9\uD55C \uC190\uB2D8\uC740 \uBB3C\uAC74\uC744
      \uBC14\uB2E5\uC5D0 \uBC84\uB9BD\uB2C8\uB2E4. \n<color=#ff4d4d>\uC7A5\uC0AC\uAC00
      \uB05D\uB098\uBA74 \uC0AC\uB77C\uC9C0\uB2C8</color> \uBBF8\uB9AC \uC90D\uACE0,
      \uD3AB\uB9D0\uACFC \uB2E4\uC2DC \uC0C1\uD638\uC791\uC6A9\uD558\uC5EC \uC0C1\uC810\uC744
      \uB9C8\uAC10\uD558\uC138\uC694. \n\uC7A5\uC0AC \uC885\uB8CC \uC2DC <color=#fff64d>\uCD1D
      \uB9E4\uCD9C \uC601\uC218\uC99D</color>\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 45446340259840
    m_Localized: "\uC800\uC7A5\uACFC \uD734\uC2DD"
    m_Metadata:
      m_Items: []
  - m_Id: 45454695313408
    m_Localized: "<color=#fff64d>\uC77C\uAE30\uC7A5</color>\uACFC \uC0C1\uD638\uC791\uC6A9\uD558\uC5EC
      \uAC8C\uC784\uC744 \uC800\uC7A5\uD558\uACE0, \n<color=#fff64d>\uCE68\uB300</color>\uC5D0\uC11C
      \uC7A0\uC744 \uC790\uBA74 \uB2E4\uC74C \uB0A0\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
