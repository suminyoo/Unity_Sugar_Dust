MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: f4073b05ce61ad142921eac5dffafc13, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 313319006208
    m_Localized: Goodbye.
    m_Metadata:
      m_Items: []
  - m_Id: 313327394816
    m_Localized: I`m busy.
    m_Metadata:
      m_Items: []
  - m_Id: 313327394817
    m_Localized: I`ll just look around.
    m_Metadata:
      m_Items: []
  - m_Id: 313327394820
    m_Localized: Feel free to look around anytime.
    m_Metadata:
      m_Items: []
  - m_Id: 313327394821
    m_Localized: Hi? Where are you heading today?
    m_Metadata:
      m_Items: []
  - m_Id: 313327394824
    m_Localized: 'Hello, boss.

      I don''t have a single penny right now.

      Could
      you just give this to me?'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394825
    m_Localized: 'I really want to buy this.

      But I have no money on me.

      Just
      think of it as charity and give me one.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394826
    m_Localized: 'I haven''t eaten anything for days.

      Can I take this?

      I
      will definitely pay you back later.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394827
    m_Localized: 'I wanted it so much while looking around.

      But I didn''t
      bring my wallet.

      Can''t you give it to me for free?'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394828
    m_Localized: 'Excuse me, this is too expensive.

      Can''t you give me a little
      discount?

      I''ll be a regular, please?'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394829
    m_Localized: 'Hey, I know the original price.

      This much should be enough,
      right?

      Let''s make it cheap.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394830
    m_Localized: 'I like the item.

      But the price is a bit disappointing.

      Please
      lower it a bit.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394831
    m_Localized: 'It was cheaper at other shops.

      I''ll buy it here, so give
      me a discount.

      I''m counting on your sense, boss.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394832
    m_Localized: 'Ah, this is taking forever.

      Hurry up and ring me up.

      I''m
      busy, you know.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394833
    m_Localized: 'What are you doing not checking me out?

      Let''s get this
      done quickly.

      I''m dying of waiting.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394834
    m_Localized: 'Why are your movements so slow?

      Give me this quickly.

      I
      don''t have time.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394835
    m_Localized: 'Excuse me, can you check me out first?

      I have an urgent
      matter.

      Hurry, hurry!'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394836
    m_Localized: 'Hello.

      The items are really good.

      I''ll take this.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394837
    m_Localized: 'The shop is very neat.

      I enjoyed looking around.

      I''ll
      buy this one.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394838
    m_Localized: 'Hmm, just what I was looking for.

      The quality looks fine.

      Checkout,
      please.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394839
    m_Localized: 'First time visiting this shop.

      I should come by often.

      I''ll
      take this, please.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394840
    m_Localized: 'I was looking for a gift for a friend.

      This is exactly what
      I wanted.

      I''ll pay for this.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394841
    m_Localized: 'I just ran out of this at home.

      I''m glad you have it in
      stock.

      Checkout, please.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394842
    m_Localized: 'All the items look good.

      I had a hard time choosing, but
      I''ll take this.

      Here is the money.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394843
    m_Localized: 'Hello, the weather is really nice.

      I''m in a good mood,
      keep the change.

      Keep up the good work!'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394844
    m_Localized: 'I love the item so much.

      This is a small token of my appreciation.

      You
      don''t have to give me change.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394845
    m_Localized: 'You are very kind, boss.

      I''ll give you the rest as a tip.

      May
      your business prosper.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394848
    m_Localized: 'Look who''s here our cute little human!

      These weapons are
      dangerous for you.

      But there are some weapons that you can use.'
    m_Metadata:
      m_Items: []
  - m_Id: 313327394849
    m_Localized: Hello.
    m_Metadata:
      m_Items: []
  - m_Id: 313327394850
    m_Localized: Do you need something?
    m_Metadata:
      m_Items: []
  - m_Id: 313327394851
    m_Localized: What are you selling here?
    m_Metadata:
      m_Items: []
  - m_Id: 313352560641
    m_Localized: Selling weapons!
    m_Metadata:
      m_Items: []
  - m_Id: 313352560642
    m_Localized: Checkout, please.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560643
    m_Localized: I`ll come again next time.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560644
    m_Localized: Tsk, whatever.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560645
    m_Localized: Wow, it`s free? Awesome!
    m_Metadata:
      m_Items: []
  - m_Id: 313352560646
    m_Localized: Hmm, good price. I`ll buy it.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560647
    m_Localized: Huh? The item disappeared already.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560648
    m_Localized: Oh? Out of stock...
    m_Metadata:
      m_Items: []
  - m_Id: 313352560649
    m_Localized: Nothing worth buying here.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560650
    m_Localized: The line is too long... I should just go.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560651
    m_Localized: Thank you.
    m_Metadata:
      m_Items: []
  - m_Id: 313352560652
    m_Localized: '{0} gold? What a rip-off!'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
