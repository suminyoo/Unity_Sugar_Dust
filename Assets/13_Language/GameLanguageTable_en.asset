      m_Items: []
  - m_Id: 2337027895323
    m_Localized: Purple Sugar Dust. They say it`s dry but sweet as candy.
    m_Metadata:
      m_Items: []
  - m_Id: 2337027895324
    m_Localized: Blue Sugar Dust
