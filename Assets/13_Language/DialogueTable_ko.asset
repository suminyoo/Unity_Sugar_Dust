  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: f4073b05ce61ad142921eac5dffafc13, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 313319006208
    m_Localized: "\uC798\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394816
    m_Localized: "\uB098 \uBC14\uBE60"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394817
    m_Localized: "\uBB3C\uAC74 \uC880 \uBCFC\uAC8C"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394818
    m_Localized: "\uC544\uD508\uB370 \uC788\uC73C\uBA74 \uB610 \uC624\uB834"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394819
    m_Localized: "\uB9CE\uC774 \uC0AC\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394820
    m_Localized: "\uC5B8\uC81C\uB4E0 \uAD6C\uACBD\uD574\uB3C4 \uB3FC"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394821
    m_Localized: "\uC548\uB155! \uC624\uB298\uC740 \uC5B4\uB514\uAC00?"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394822
    m_Localized: "\uBB34\uAE30\uB3C4 \uBABB\uB4E4\uAC70 \uAC19\uC740\uB370 \uBB34\uAE30
      \uC0C1\uC810\uC5D4 \uBB34\uC2A8\uC77C\uC774\uC57C?\n\uC800\uAE30 \uAC00\uC11C
      \uC0AC\uD0D5\uC774\uB098 \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394823
    m_Localized: "\uC5B4... \uD63C\uC790 \uBCFC\uAC8C\uC694.....\n\uC544\uB1E8...
      \uAD1C\uCC2E\uC544\uC694....\n\uD638...\uD63C\uC790 \uC788\uAC8C \uD574\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394824
    m_Localized: "\uC548\uB155\uD558\uC138\uC694 \uC0AC\uC7A5\uB2D8.\n\uC81C\uAC00
      \uC9C0\uAE08 \uB3C8\uC774 \uD55C \uD47C\uB3C4 \uC5C6\uB294\uB370\uC694.\n\uC774\uAC70
      \uADF8\uB0E5 \uC8FC\uC2DC\uBA74 \uC548 \uB420\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394825
    m_Localized: "\uC774\uAC70 \uC815\uB9D0 \uAF2D \uC0AC\uACE0 \uC2F6\uC740\uB370\uC694.\n\uC218\uC911\uC5D0
      \uB3C8\uC774 \uC5C6\uB124\uC694.\n\uC801\uC120\uD558\uB294 \uC148 \uCE58\uACE0
      \uD558\uB098\uB9CC \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394826
    m_Localized: "\uBA70\uCE60\uC9F8 \uC544\uBB34\uAC83\uB3C4 \uBABB \uBA39\uC5C8\uC5B4\uC694.\n\uC774\uAC83
      \uC880 \uAC00\uC838\uAC00\uB3C4 \uB420\uAE4C\uC694?\n\uB098\uC911\uC5D0 \uAF2D
      \uAC1A\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394827
    m_Localized: "\uAD6C\uACBD\uD558\uB2E4 \uBCF4\uB2C8 \uB108\uBB34 \uD0D0\uB098\uC11C\uC694.\n\uADFC\uB370
      \uC9C0\uAC11\uC744 \uC548 \uAC00\uC838\uC654\uB124\uC694.\n\uACF5\uC9DC\uB85C
      \uC8FC\uC2DC\uBA74 \uC548 \uB420\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394828
    m_Localized: "\uC800\uAE30\uC694, \uC774\uAC70 \uB108\uBB34 \uBE44\uC2FC\uB370\uC694.\n\uC870\uAE08\uB9CC
      \uAE4E\uC544\uC8FC\uC2DC\uBA74 \uC548 \uB420\uAE4C\uC694?\n\uB2E8\uACE8 \uD560\uAC8C\uC694,
      \uB124?"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394829
    m_Localized: "\uC5D0\uC774, \uC6D0\uB798 \uAC00\uACA9 \uB2E4 \uC544\uB294\uB370.\n\uC774
      \uC815\uB3C4\uB9CC \uB0B4\uBA74 \uB531 \uB9DE\uC8E0?\n\uC2F8\uAC8C\uC2F8\uAC8C
      \uAC11\uC2DC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394830
    m_Localized: "\uBB3C\uAC74\uC740 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uB370\uC694.\n\uAC00\uACA9\uC774
      \uC0B4\uC9DD \uC544\uC27D\uB124\uC694.\n\uC870\uAE08\uB9CC \uAE4E\uC544\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394831
    m_Localized: "\uB2E4\uB978 \uAC00\uAC8C\uB294 \uB354 \uC2F8\uB358\uB370\uC694.\n\uC5EC\uAE30\uC11C
      \uC0B4 \uD14C\uB2C8\uAE4C \uC5D0\uB204\uB9AC \uC880 \uD574\uC918\uC694.\n\uC0AC\uC7A5\uB2D8
      \uC13C\uC2A4 \uBBFF\uC744\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394832
    m_Localized: "\uC544, \uC9C4\uC9DC \uC624\uB798 \uAC78\uB9AC\uB124.\n\uBE68\uB9AC\uBE68\uB9AC
      \uACC4\uC0B0\uD574 \uC8FC\uC138\uC694.\n\uC800 \uBC14\uC058\uB2E8 \uB9D0\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394833
    m_Localized: "\uACC4\uC0B0 \uC548 \uD558\uACE0 \uBB50 \uD558\uC138\uC694?\n\uBE68\uB9AC
      \uC880 \uCC98\uB9AC\uD569\uC2DC\uB2E4.\n\uC228 \uB118\uC5B4\uAC00\uACA0\uB124."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394834
    m_Localized: "\uB3D9\uC791\uC774 \uC65C \uC774\uB807\uAC8C \uAD7C\uB5A0\uC694?\n\uBE68\uB9AC
      \uC774\uAC70 \uC8FC\uC138\uC694.\n\uC2DC\uAC04 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394835
    m_Localized: "\uC800\uAE30\uC694, \uC800\uBD80\uD130 \uACC4\uC0B0\uD574 \uC8FC\uC2DC\uBA74
      \uC548 \uB420\uAE4C\uC694?\n\uAE09\uD55C \uC77C\uC774 \uC788\uC5B4\uC11C \uADF8\uB798\uC694.\n\uBE68\uB9AC\uC694
      \uBE68\uB9AC!"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394836
    m_Localized: "\uC548\uB155\uD558\uC138\uC694.\n\uBB3C\uAC74\uC774 \uCC38 \uC88B\uB124\uC694.\n\uC774\uAC78\uB85C
      \uACC4\uC0B0\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394837
    m_Localized: "\uAC00\uAC8C\uAC00 \uC544\uC8FC \uAE54\uB054\uD558\uB124\uC694.\n\uAD6C\uACBD
      \uC798 \uD588\uC2B5\uB2C8\uB2E4.\n\uC774\uAC70 \uD558\uB098 \uC0B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394838
    m_Localized: "\uC74C, \uB531 \uCC3E\uB358 \uBB3C\uAC74\uC774\uB124\uC694.\n\uD488\uC9C8\uC774
      \uAD1C\uCC2E\uC544 \uBCF4\uC5EC\uC694.\n\uACC4\uC0B0 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394839
    m_Localized: "\uCC98\uC74C \uC640\uBCF4\uB294 \uAC00\uAC8C\uB124\uC694.\n\uC790\uC8FC
      \uB4E4\uB7EC\uC57C\uACA0\uC5B4\uC694.\n\uC774\uAC70 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394840
    m_Localized: "\uCE5C\uAD6C\uC5D0\uAC8C \uC904 \uC120\uBB3C\uC744 \uCC3E\uACE0
      \uC788\uC5C8\uC5B4\uC694.\n\uB531 \uB9C8\uC74C\uC5D0 \uB4DC\uB124\uC694.\n\uC774\uAC78\uB85C
      \uACC4\uC0B0\uD560\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394841
    m_Localized: "\uB9C8\uCE68 \uC9D1\uC5D0 \uC774\uAC8C \uB2E4 \uB5A8\uC5B4\uC84C\uAC70\uB4E0\uC694.\n\uC7AC\uACE0\uAC00
      \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uB124\uC694.\n\uACC4\uC0B0 \uBD80\uD0C1\uB4DC\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394842
    m_Localized: "\uBB3C\uAC74\uB4E4\uC774 \uB2E4 \uC88B\uC544 \uBCF4\uC774\uB124\uC694.\n\uACE0\uBBFC\uD558\uB2E4\uAC00
      \uC774\uAC78\uB85C \uACE8\uB790\uC5B4\uC694.\n\uC5EC\uAE30 \uB3C8\uC774\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394843
    m_Localized: "\uC548\uB155\uD558\uC138\uC694, \uB0A0\uC528\uAC00 \uCC38 \uC88B\uB124\uC694.\n\uAE30\uBD84\uC774\uB2E4,
      \uC794\uB3C8\uC740 \uAC00\uC9C0\uC138\uC694.\n\uC218\uACE0\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394844
    m_Localized: "\uBB3C\uAC74\uC774 \uB108\uBB34 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uC694.\n\uC774\uAC74
      \uC81C \uC791\uC740 \uC131\uC758\uC785\uB2C8\uB2E4.\n\uC794\uB3C8\uC740 \uC548
      \uC8FC\uC154\uB3C4 \uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394845
    m_Localized: "\uC0AC\uC7A5\uB2D8\uC774 \uCC38 \uCE5C\uC808\uD558\uC2DC\uB124\uC694.\n\uB0A8\uB294
      \uB3C8\uC740 \uD301\uC73C\uB85C \uB4DC\uB9B4\uAC8C\uC694.\n\uBC88\uCC3D\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394846
    m_Localized: "\uC778\uAC04\uC740 \uC6B0\uB9AC\uB791 \uAD6C\uC870\uAC00 \uB9CE\uC774
      \uB2E4\uB978\uAC70 \uAC19\uB354\uB77C\uACE0.\n\uC74C... \uB110 \uACE0\uCE60
      \uC218 \uC5C6\uB2E4\uB294 \uAC74 \uC544\uB2C8\uACE0... \uC8FD\uC9C0 \uC54A\uAC8C
      \uD574\uC904 \uC218\uB294 \uC788\uC5B4.\n\uADFC\uB370 \uB124\uAC00 \uC548 \uB2E4\uCE58\uBA74
      \uB418\uC796\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394847
    m_Localized: "\uBAB8\uC774 \uC544\uD504\uBA74 \uC57D\uC744 \uBA39\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394848
    m_Localized: "\uC548\uB155! \uC6B0\uB9AC \uADC0\uC5EC\uC6B4 \uC778\uAC04 \uAF2C\uB9C8\uC796\uC544?\n\uB108\uC5D0\uAC8C
      \uC774 \uBB34\uAE30\uB4E4\uC740 \uC704\uD5D8\uD574.\n\uD558\uC9C0\uB9CC \uB124\uAC00
      \uC4F8\uB9CC\uD55C \uBB34\uAE30\uB3C4 \uC788\uB2E8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 313327394849
    m_Localized: "\uC548\uB155"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394850
    m_Localized: "\uBB34\uC2A8 \uBCFC\uC77C\uC774\uB77C\uB3C4?"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394851
    m_Localized: "\uC5EC\uAE30 \uBB50 \uD314\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 313327394852
    m_Localized: "\uAC04\uD638\uC0AC \uC5EC\uAE30 \uD658\uC790 \uC880 \uBD10\uC918"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560640
    m_Localized: "\uC57D \uD314\uC544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560641
    m_Localized: "\uBB34\uAE30 \uD314\uC544\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560642
    m_Localized: "\uACC4\uC0B0\uD574\uC8FC\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560643
    m_Localized: "\uB2E4\uC74C\uC5D0 \uB610 \uC62C\uAC8C\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560644
    m_Localized: "\uCCC7 \uBB50\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 313352560645
    m_Localized: "\uC640 \uACF5\uC9DC\uB124? \uC544\uC2F8!"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560646
    m_Localized: "\uC74C, \uAC00\uACA9 \uAD1C\uCC2E\uB124. \uC0AC\uC57C\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 313352560647
    m_Localized: "\uC5B4? \uBB3C\uAC74\uC774 \uADF8\uC0C8 \uC5C6\uC5B4\uC84C\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560648
    m_Localized: "\uC5B4? \uC7AC\uACE0\uAC00 \uC5C6\uB124..."
    m_Metadata:
      m_Items: []
  - m_Id: 313352560649
    m_Localized: "\uC5EC\uAE34 \uC0B4\uB9CC\uD55C\uAC8C \uC5C6\uB124"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560650
    m_Localized: "\uC904 \uB108\uBB34 \uAE34\uB370... \uADF8\uB0E5 \uAC00\uC57C\uACA0\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 313352560651
    m_Localized: "\uAC10\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 313352560652
    m_Localized: "{0}\uACE8\uB4DC? \uC644\uC804 \uBC14\uAC00\uC9C0\uC796\uC544!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
