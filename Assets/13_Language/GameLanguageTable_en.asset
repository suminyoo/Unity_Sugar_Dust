    m_Metadata:
      m_Items: []
  - m_Id: 2337027895326
    m_Localized: Green Sugar Dust
    m_Metadata:
      m_Items: []
  - m_Id: 2337027895327
    m_Localized: Green Sugar Dust. Said to be sticky but have a sour kick.
    m_Metadata:
      m_Items: []
  - m_Id: 2337027895328
    m_Localized: Sky Blue Sugar Dust
    m_Metadata:
      m_Items: []
