  m_TableData:
  - m_Id: 2337015312384
    m_Localized: "\uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 2337015312387
    m_Localized: "\uD0D0\uC0AC\uB97C \uB9C8\uCE58\uACE0 \uB9C8\uC744\uB85C \uB3CC\uC544\uAC00\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2337015312388
    m_Localized: "\uC815\uB9D0\uB85C \uAC78\uC5B4\uC11C \uB9C8\uC744\uB85C \uB3CC\uC544\uAC00\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2337015312389
    m_Localized: "\uB354 \uAE4A\uC740 \uACF3 \uD0D0\uC0AC\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337015312390
    m_Localized: "\uB2E4\uC74C \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2337015312391
    m_Localized: "\uC800\uB141\uC774 \uB418\uC5B4 \uAE30\uC628\uC774 \uAE09\uACA9\uD788
      \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506688
    m_Localized: "\uC9C0\uAE08 \uB098\uAC00\uAE30\uC5D0\uB294 \uB108\uBB34 \uCDA5\uACE0
      \uC704\uD5D8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506689
    m_Localized: "\uBCF5\uC7A1\uD55C \uAE38 \uB54C\uBB38\uC5D0 \uB418\uB3CC\uC544\uC654\uB2E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506690
    m_Localized: "\uC774\uC81C \uAE38\uC744 \uD655\uC2E4\uD788 \uC54C \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506691
    m_Localized: "\uC5B4\uB290 \uC815\uB3C4 \uAE38\uC774 \uC775\uC219\uD574\uC84C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506692
    m_Localized: "\uC544\uC9C1 \uAE38\uC774 \uD5F7\uAC08\uB9B0\uB2E4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506693
    m_Localized: "\uD0D0\uC0AC \uC131\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506694
    m_Localized: "\uC6B0\uC8FC\uC120\uC744 \uD0C0\uACE0 \uB9C8\uC744\uB85C \uBB34\uC0AC\uD788
      \uADC0\uD658\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506695
    m_Localized: "\uD0D0\uC0AC \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506696
    m_Localized: "\uAC78\uC5B4\uC11C \uB9C8\uC744\uB85C \uADC0\uD658\uD569\uB2C8\uB2E4.\n\uB3CC\uC544\uAC00\uB294
      \uAE38\uC5D0 \uBA87\uBA87 \uC544\uC774\uD15C\uC744 \uC783\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506697
    m_Localized: "\uD0D0\uC0AC \uC2E4\uD328"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506698
    m_Localized: "\uAD6C\uC870\uB300\uC5D0 \uC758\uD574\n\uBCD1\uC6D0\uC73C\uB85C
      \uC774\uC1A1\uB429\uB2C8\uB2E4.\n\uC544\uC774\uD15C\uC744 \uBAA8\uB450 \uC783\uC5B4\uBC84\uB838\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506699
    m_Localized: "{0} {1:00} \uAD6C\uC5ED"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506700
    m_Localized: "\uC77C\uBAB0\uAE4C\uC9C0 \uC608\uC0C1\uC2DC\uAC04"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506701
    m_Localized: "{0} {1:00} \uAD6C\uC5ED \uD0D0\uC0AC\uB97C \uC2DC\uC791\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506702
    m_Localized: "{0} \uB4E4\uC5B4\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506703
    m_Localized: "{0} \uB098\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506704
    m_Localized: "[LMB] \uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506705
    m_Localized: "[RMB] \uCC44\uAD11"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506706
    m_Localized: "\uC7A0\uC790\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506707
    m_Localized: "\uC7A0\uC790\uB9AC\uC5D0 \uB4DC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506709
    m_Localized: "\uC9C4\uC5F4\uB300 \uC5F4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506710
    m_Localized: "\uC0C1\uC810 \uC6B4\uC601 \uC2DC\uC791\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506711
    m_Localized: "\uC601\uC5C5\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506712
    m_Localized: "\uC601\uC5C5\uC774 \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506713
    m_Localized: "\uC0C1\uC810 \uC77C\uCC0D \uB9C8\uAC10\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506714
    m_Localized: "\uC601\uC5C5\uC744 \uC870\uAE30 \uB9C8\uAC10\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506715
    m_Localized: "\uC0C1\uC810 \uB9C8\uAC10\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506716
    m_Localized: "\uC601\uC5C5\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506717
    m_Localized: "\uC0C1\uC810 \uC601\uC5C5\uC740 \uC800\uB141\uC5D0 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506718
    m_Localized: "\uC601\uC5C5 \uC911\uC5D0\uB294 \uB098\uAC08 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506719
    m_Localized: "\uD310\uB9E4 \uC911\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506720
    m_Localized: "\uD310\uB9E4 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506721
    m_Localized: "\uBB3C\uAC74 \uACB0\uC81C\uD574\uC8FC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506722
    m_Localized: "\uB300\uAE30 \uC911\uC778 \uC190\uB2D8\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506723
    m_Localized: "\uC7AC\uACE0: \uBB34\uC81C\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506724
    m_Localized: "\uB3C8\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506725
    m_Localized: "<color={0}>(\uBC14\uB2E5\uC5D0 \uB5A8\uC5B4\uC9C4 \uC544\uC774\uD15C\uC740
      \uC0AC\uB77C\uC9D1\uB2C8\uB2E4)</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506726
    m_Localized: "\uC544\uC9C1 \uC601\uC5C5 \uC911\uC785\uB2C8\uB2E4.\n\uC9C0\uAE08
      \uB9C8\uAC10\uD558\uACE0 \uC815\uC0B0\uD558\uACA0\uC2B5\uB2C8\uAE4C?\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506727
    m_Localized: "\uC601\uC5C5\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC624\uB298\uC758
      \uC815\uC0B0 \uB0B4\uC5ED\uC744 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uAE4C?\n{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506728
    m_Localized: "\uB4F1\uB85D\uD55C \uAC00\uACA9: {0:N0} {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506729
    m_Localized: "\uAC00\uC838\uC628 \uAC1C\uC218: {0} \uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506730
    m_Localized: "{0}\uC774(\uAC00) \uBD80\uC871\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506731
    m_Localized: "\uAC00\uACA9: {0:N0} {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2337019506732
    m_Localized: "\uBB34\uAC8C: {0:F1}kg"
    m_Metadata:
      m_Items: []
  - m_Id: 2337023700992
    m_Localized: "\uC7AC\uACE0: {0}\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 2337023700993
